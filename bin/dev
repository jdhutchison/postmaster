#!/usr/bin/env bash
# Runs Postmaster in Quarkus dev mode (live reload) at http://localhost:8080/mail
#
# Usage: bin/dev [extra Gradle arguments]
#
# Dev mode needs no services: it uses an in-memory H2 database filled with fake data (see the
# "%dev" profile in application.yaml and config/DevData.kt), and scheduled processing is off.
# The data is recreated on every restart. The startup configuration is config/dev.yml.
set -euo pipefail
source "$(dirname "$0")/_common.sh"

exec ./gradlew quarkusDev -Dquarkus.analytics.disabled=true "$@"
