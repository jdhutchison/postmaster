#!/usr/bin/env bash
# Fake headless Chromium for tests. Every invocation is recorded in calls/
# next to this script as <n>.args (arguments separated by NUL bytes).
#
# For --dump-dom it fetches the URL with curl, sending the --user-agent value,
# so WireMock stubs answer both the browser and curl code paths. If a file
# named "fail" exists next to this script, its contents are written to stderr
# and the script exits with status 1.
set -u
dir="$(cd "$(dirname "$0")" && pwd)"
calls="$dir/calls"
mkdir -p "$calls"
printf '%s\0' "$@" > "$calls/$(date +%s%N)-$$.args"

if [[ -f "$dir/fail" ]]; then
  cat "$dir/fail" >&2
  exit 1
fi

agent=""
url=""
for arg in "$@"; do
  case "$arg" in
    --version) echo "Chromium 140.0.0.0 (fake)"; exit 0 ;;
    --user-agent=*) agent="${arg#--user-agent=}" ;;
    http://*|https://*) url="$arg" ;;
  esac
done

if [[ -z "$url" ]]; then
  echo "fake chromium: no URL given" >&2
  exit 2
fi
exec curl -sS -L --fail -A "$agent" "$url"
